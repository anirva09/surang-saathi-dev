# Surang Saathi web — configuration
#
# Copy to `.env.local` and adjust. Every variable here is read on the SERVER
# only: none is prefixed NEXT_PUBLIC_, so none is inlined into the browser
# bundle. The browser never talks to the API directly, which is also why the
# backend's CORS allowlist does not have to know about this app's port.

# Where the Surang Saathi API is listening. Must match the backend's own
# API_PORT (default 8000 in the backend's docker-compose).
API_BASE_URL=http://localhost:8000

# The mine this prototype is scoped to. MINE-03 is what the backend seeds.
DEMO_MINE_ID=MINE-03

# The user mutations are recorded against.
#
# There is NO authentication service in this prototype. This is a named,
# configurable demonstration user, not a session, a token or a sign-in: the
# audit ledger records this id honestly so every recorded decision can be traced
# to the account that is actually acting. USR-MSHARMA is the seeded safety
# officer.
PROTOTYPE_ACTOR_ID=USR-MSHARMA

# How long a request may hang before the page shows its API-unreachable state.
API_TIMEOUT_MS=8000

# Port the Playwright accessibility suite runs its own dev server on. It is
# deliberately not 3000, so the suite never attaches to a dev server left
# running from another checkout.
A11Y_PORT=3010
